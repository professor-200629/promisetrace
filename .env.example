# Copy to .env (never commit .env). Every value below is optional for a first
# local run: missing credentials put the app into a clearly labelled setup or
# fixture state instead of failing silently.

# --- App ---
DATABASE_URL="file:./dev.db"
# Public base URL of this app (used for auth origin checks and links)
APP_URL="http://localhost:3000"
# 32+ random characters. Generate with: npx @better-auth/cli secret  (or any password generator)
BETTER_AUTH_SECRET=""

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Webhook ID shown after you add a webhook listener URL to the sandbox app.
# Leave empty locally; webhooks need a public HTTPS URL.
PAYPAL_WEBHOOK_ID=""
# "sandbox" (default) or "fixture". Fixture never calls PayPal and every
# fixture payment is labelled FIXTURE in the UI and in exports. Offline dev only.
PAYPAL_MODE="sandbox"

# --- AI (runtime API access; separate from any Claude subscription) ---
# "anthropic" (default) or "fixture" (offline, labelled, deterministic sample output)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# Anthropic API endpoint. Set explicitly so a machine-wide ANTHROPIC_BASE_URL cannot redirect requests.
AI_BASE_URL="https://api.anthropic.com"
# low | medium | high
AI_EFFORT="low"
AI_MAX_OUTPUT_TOKENS="8000"
# Hard cap on characters sent per extraction
AI_MAX_INPUT_CHARS="20000"
# Hard cap on AI calls per UTC day across the whole app
AI_DAILY_CALL_LIMIT="40"
# USD per million tokens, used for the cost log (defaults match claude-opus-5-5 list price)
AI_PRICE_INPUT_PER_MTOK="4"
AI_PRICE_OUTPUT_PER_MTOK="20"

# --- Uploads ---
MAX_UPLOAD_BYTES="5242880"
MAX_FILES_PER_DELIVERY="10"
