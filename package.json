{
  "name": "promisetrace",
  "version": "0.1.0",
  "private": true,
  "description": "Source-linked purchase briefs, PayPal sandbox checkout and requirement-by-requirement delivery checks for independent digital-service sellers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "paypal:check": "tsx scripts/paypal-check.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "eval": "tsx eval/run-eval.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@libsql/client": "0.17.2",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
